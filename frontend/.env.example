# Web3Forms access key for the contact form (https://web3forms.com).
# Without it, the form opens the visitor's email app with the message pre-filled.
VITE_WEB3FORMS_ACCESS_KEY=

# Cookieless Vercel Web Analytics. Enable Analytics for the project in the Vercel
# dashboard first (otherwise the collector script 404s), then set this to "vercel".
VITE_ANALYTICS=
